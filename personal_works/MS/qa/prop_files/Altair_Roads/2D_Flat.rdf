$--------------------------------------------------------------------------UNITS
[UNITS]
 LENGTH             = 'mm'
 FORCE              = 'newton'
 ANGLE              = 'radians'
 MASS               = 'kg'
 TIME               = 'sec'
$--------------------------------------------------------------------------MODEL
[MODEL]
 METHOD             = '2D'
 ROAD_TYPE          = 'Flat'
$-----------------------------------------------------------------------GRAPHICS
[GRAPHICS]
 LENGTH             = 1000.0
 WIDTH              = 36000.0
 ROAD_INCR          = -1000
$---------------------------------------------------------------------PARAMETERS
[PARAMETERS]
 MU                 =  0.1
 ROTATION_ANGLE_XY_PLANE =   90
$---------------------------------------------------------------------OFFSET
[OFFSET]
 Z                 =  0.0
